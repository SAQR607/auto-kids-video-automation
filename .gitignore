# --- Secrets (never commit) ---
.env
.env.*
!.env.example
client_secret*.json
credentials*.json
token*.json
*oauth*secret*
state/secrets/

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# --- Generated media (never commit) ---
workspace/
outputs/
*.zip
*.mp4
*.mov
*.mkv
*.avi
*.wav
*.mp3
*.m4a
*.aac
*.ogg
*.srt
*.ass

# --- Hand-drawn art originals (user archive; committed sources live in
#     assets/characters_src/ + assets/props_src/, regenerable via the
#     _*.py converters — locations are output-only: assets/locations/ is
#     the single committed copy, installed from *_new/ by the converter) ---
assets/characters/*_new/
assets/props_new/
assets/locations/*_new/

# --- Throwaway scripts / review images at repo root ---
/_*.py
/z_*.png
/z_*.txt
/*_contact.png
/*_dynamic.png
/*_sheet.png
/*_big.png

# --- Model / tool caches (downloaded at runtime) ---
.cache/
.models/
hf_home/
models/

# --- Episode runtime artifacts (regenerated by pipeline) ---
state/cache/
state/episodes/*/audio/
state/episodes/*/video/
state/episodes/*/render/
state/episodes/*/qc/
state/episodes/*/uploads/
# NOTE: state/episodes/*/shorts/*.json MUST be tracked — shorts-day runs
# rebuild rendered shorts from those docs on a fresh checkout.

# --- Non-default channel profiles (mirror the rules above) ---
workspace_*/
state*/secrets/
state*/cache/
state*/episodes/*/audio/
state*/episodes/*/video/
state*/episodes/*/render/
state*/episodes/*/qc/
state*/episodes/*/uploads/

# --- Logs ---
*.log
logs/

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
*.lnk
.idea/
.vscode/

# --- Nested/duplicate release copies (never upload) ---
release/
