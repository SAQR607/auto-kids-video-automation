# --- Secrets (never commit) ---
.env
.env.*
!.env.example
client_secret*.json
credentials*.json
token*.json
*oauth*secret*

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# --- Generated media (never commit) ---
workspace/
outputs/
*.mp4
*.mov
*.mkv
*.avi
*.wav
*.mp3
*.m4a
*.aac
*.ogg
*.srt
*.ass

# --- Model / tool caches (downloaded at runtime) ---
.cache/
.models/
hf_home/
models/

# --- Episode runtime artifacts (regenerated by pipeline) ---
state/cache/
state/episodes/*/audio/
state/episodes/*/video/
state/episodes/*/shorts/
state/episodes/*/qc/
state/episodes/*/uploads/

# --- Logs ---
*.log
logs/

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
